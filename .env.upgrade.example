# LOCAL DEVELOPMENT ONLY. Replace every change-me value before starting.
BOOKING_DB_ROOT_PASSWORD=change-me-local-booking-root
BOOKING_DB_USERNAME=smartoffice_booking
BOOKING_DB_PASSWORD=change-me-local-booking-db
USER_DB_ROOT_PASSWORD=change-me-local-user-root
USER_DB_USERNAME=smartoffice_user
USER_DB_PASSWORD=change-me-local-user-db
REDIS_PASSWORD=change-me-local-redis
# Same value is passed to both backend services; at least 32 UTF-8 bytes.
JWT_SECRET=change-me-local-jwt-secret-at-least-32-bytes-long
# Base64 of a disposable >=32-byte local string. Generate a fresh value using docs.
NACOS_AUTH_TOKEN=Y2hhbmdlLW1lLWxvY2FsLW5hY29zLXNlY3JldC1hdC1sZWFzdC0zMi1ieXRlcw==
NACOS_AUTH_IDENTITY_KEY=smartofficeLocalIdentity
NACOS_AUTH_IDENTITY_VALUE=change-me-local-nacos-identity
FRONTEND_HOST_PORT=18080
GATEWAY_HOST_PORT=18000
NACOS_CONSOLE_HOST_PORT=18880
CORS_ALLOWED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080
