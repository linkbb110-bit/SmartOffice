+package com.geek.smartoffice.controller;
+
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.geek.smartoffice.common.result.Result;
+import com.geek.smartoffice.model.entity.MeetingRoom;
+import com.geek.smartoffice.model.vo.RoomVO;
+import com.geek.smartoffice.service.MeetingRoomService;
+import org.springframework.beans.BeanUtils;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.util.StringUtils;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.stream.Collectors;
+
+@RestController
+@RequestMapping("/rooms")
+public class RoomQueryController {
+
+    @Autowired
+    private MeetingRoomService meetingRoomService;
+
+    @Autowired
+    private ObjectMapper objectMapper;
+
+    @GetMapping("/list")
+    public Result<List<RoomVO>> listRooms() {
+        List<RoomVO> rooms = meetingRoomService.list()
+                .stream()
+                .map(this::toRoomVO)
+                .collect(Collectors.toList());
+        return Result.success(rooms);
+    }
+
+    private RoomVO toRoomVO(MeetingRoom room) {
+        RoomVO vo = new RoomVO();
+        BeanUtils.copyProperties(room, vo);
+        vo.setEquipment(parseEquipment(room.getEquipment()));
+        return vo;
+    }
+
+    private List<String> parseEquipment(String equipment) {
+        if (!StringUtils.hasText(equipment)) {
+            return Collections.emptyList();
+        }
+
+        String text = equipment.trim();
+        if (text.startsWith("[") && text.endsWith("]")) {
+            try {
+                return objectMapper.readValue(text, new TypeReference<List<String>>() {
+                }).stream()
+                        .filter(StringUtils::hasText)
+                        .collect(Collectors.toList());
+            } catch (Exception ignored) {
+                // Fall back to comma-separated parsing for legacy data.
+            }
+        }
+
+        return Arrays.stream(text.split("[,\\uFF0C\\u3001]"))
+                .map(String::trim)
+                .filter(StringUtils::hasText)
+                .collect(Collectors.toList());
+    }
+}
