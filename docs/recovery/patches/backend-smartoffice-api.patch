@@ -0,0 +1,41 @@
+package com.geek.smartoffice.controller;
+
+import com.geek.smartoffice.common.annotation.Idempotent;
+import com.geek.smartoffice.common.annotation.OperationLog;
+import com.geek.smartoffice.common.annotation.RateLimit;
+import com.geek.smartoffice.common.result.Result;
+import com.geek.smartoffice.model.dto.BookingDTO;
+import com.geek.smartoffice.model.entity.MeetingRoom;
+import com.geek.smartoffice.service.MeetingRoomService;
+import com.geek.smartoffice.service.NotificationService;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.security.core.Authentication;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.validation.annotation.Validated;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+@RequestMapping("/orders")
+public class OrderController {
+
+    @Autowired
+    private MeetingRoomService meetingRoomService;
+
+    @Autowired
+    private NotificationService notificationService;
+
+    @OperationLog("book room")
+    @Idempotent(expireMillis = 3000)
+    @RateLimit(key = "bookRoom", rate = 10, rateInterval = 1)
+    @PostMapping("/book")
+    public Result<Void> bookRoom(@Validated @RequestBody BookingDTO dto) {
+        Authentication authentication = SecurityContextHolder.getContext().getAuthentication();
+        String username = authentication == null ? "system" : authentication.getName();
+        MeetingRoom room = meetingRoomService.getRoomDetailSafely(dto.getRoomId());
+        notificationService.sendBookingSuccessEmail(username + "@company.com", room.getRoomName());
+        return Result.success();
+    }
+}
