diff --git a/src/main/java/com/geek/smartoffice/service/impl/SysUserServiceImpl.java b/src/main/java/com/geek/smartoffice/service/impl/SysUserServiceImpl.java
--- a/src/main/java/com/geek/smartoffice/service/impl/SysUserServiceImpl.java
+++ b/src/main/java/com/geek/smartoffice/service/impl/SysUserServiceImpl.java
@@ -41,0 +42,14 @@
+
+    @Override
+    public SysUser login(String username, String rawPassword) {
+        SysUser user = getOne(new LambdaQueryWrapper<SysUser>()
+                .eq(SysUser::getUsername, username)
+                .eq(SysUser::getIsDeleted, 0));
+        if (user == null || !StringUtils.hasText(user.getPassword())) {
+            throw new BusinessException(401, "用户名或密码错误");
+        }
+        if (!passwordEncoder.matches(rawPassword, user.getPassword())) {
+            throw new BusinessException(401, "用户名或密码错误");
+        }
+        return user;
+    }
